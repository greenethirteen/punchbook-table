{
  "expo": {
    "name": "Punchbook Pickup",
    "slug": "punchbook-pickup",
    "version": "1.0.12",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "order.punchbook.com"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#244633",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "order.punchbook.com",
      "versionCode": 20,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Punchbook uses your location to fill in your address."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#244633"
        }
      ]
    ],
    "scheme": "punchbook",
    "experiments": {
      "typedRoutes": true
    }
  }
}
