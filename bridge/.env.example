# SambaPOS Message Server (Windows PC on the local network), GraphQL enabled
SAMBA_URL=http://192.168.1.25:9000
SAMBA_USER=
SAMBA_PASSWORD=
# Client id registered in SambaPOS (Manage > Settings > Message Server / API clients)
SAMBA_CLIENT_ID=

# Punchbook server and this restaurant's bridge key (must match BRIDGE_KEYS on the server)
PUNCHBOOK_URL=https://punchbook.online
PUNCHBOOK_BRIDGE_KEY=
