PORT=3000
# Optional public origin; otherwise links use the incoming site address.
PUBLIC_BASE_URL=
# Admin key: locks /admin, /pickup-admin, /pos, /accounts, /owner-admin, /admin/companies and the rider page
# (the rider page also takes RIDER_KEY). Until it is set those screens are open to anyone. Use a long random value.
PUNCHBOOK_ADMIN_KEY=
# Optional persistent directory. On Railway, point this to a mounted volume path.
DATA_DIR=
# Payments.lk (https://payments.lk/developers). sk_test_… for the sandbox, sk_live_… when approved.
# Without it payments are simulated: any order can be marked paid for free. Never launch without it.
PAYMENTS_LK_SECRET_KEY=
# Signing secret of the webhook endpoint https://<your domain>/api/payments/webhook (dashboard → Developers)
PAYMENTS_LK_WEBHOOK_SECRET=
# Set false to refuse simulated payments even without a key
SIMULATE_PAYMENTS=true
# Restaurant logins for /admin and /pickup-admin (each sees only its own orders): id:secret,id:secret
RESTAURANT_KEYS=
# How far a restaurant delivers, in km (straight line from the restaurant's lat/lng in restaurants.js)
DELIVERY_RADIUS_KM=10
# Optional: Square POS bridge (console at /pos). Free sandbox at developer.squareup.com
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
# Optional; defaults to the first active location
SQUARE_LOCATION_ID=
# Punchbook restaurant linked to the Square location (can also be changed on /pos)
SQUARE_RESTAURANT_ID=peppermint
# Square has no LKR, so prices are converted into the location currency at this demo rate
SQUARE_LKR_PER_UNIT=300
# Optional: webhook signature key from the Square app's Webhooks page (needs a public HTTPS URL)
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
# Optional: local POS bridges (bridge/, e.g. SambaPOS). One secret per restaurant: id:secret,id:secret
BRIDGE_KEYS=
# Minutes after the promised time before a POS order is assumed ready if staff don't press Ready ("off" disables)
BRIDGE_AUTO_READY_MINUTES=10
# Optional access code for the rider page (/rider). Empty leaves it open for testing.
RIDER_KEY=
