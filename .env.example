PORT=3000
# Optional public origin; otherwise links use the incoming site address.
PUBLIC_BASE_URL=
# Protects /admin/companies and document access. Set a strong secret in Railway.
PUNCHBOOK_ADMIN_KEY=
# Optional persistent directory. On Railway, point this to a mounted volume path.
DATA_DIR=
# Optional: OnePay sandbox / merchant developer credentials
ONEPAY_APP_ID=
ONEPAY_HASH_SALT=
ONEPAY_APP_TOKEN=
ONEPAY_API_BASE=https://api.onepay.lk
# Set true to force simulated card checkout even if credentials are present
SIMULATE_CARD=true
