PORT=3000
# Optional public origin; otherwise links use the incoming site address.
PUBLIC_BASE_URL=
# Protects /admin/companies and document access. Set a strong secret in Railway.
PUNCHBOOK_ADMIN_KEY=
# Optional persistent directory. On Railway, point this to a mounted volume path.
DATA_DIR=
# Optional: OnePay sandbox / merchant developer credentials
ONEPAY_APP_ID=
ONEPAY_HASH_SALT=
ONEPAY_APP_TOKEN=
ONEPAY_API_BASE=https://api.onepay.lk
# Set true to force simulated card checkout even if credentials are present
SIMULATE_CARD=true
# Optional: Square POS bridge (console at /pos). Free sandbox at developer.squareup.com
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
# Optional; defaults to the first active location
SQUARE_LOCATION_ID=
# Punchbook restaurant linked to the Square location (can also be changed on /pos)
SQUARE_RESTAURANT_ID=peppermint
# Square has no LKR, so prices are converted into the location currency at this demo rate
SQUARE_LKR_PER_UNIT=300
# Optional: webhook signature key from the Square app's Webhooks page (needs a public HTTPS URL)
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
# Optional: local POS bridges (bridge/, e.g. SambaPOS). One secret per restaurant: id:secret,id:secret
BRIDGE_KEYS=
# Minutes after the promised time before a POS order is assumed ready if staff don't press Ready ("off" disables)
BRIDGE_AUTO_READY_MINUTES=10
# Optional access code for the rider page (/rider). Empty leaves it open for testing.
RIDER_KEY=
